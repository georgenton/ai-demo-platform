// -----------------------------------------------------------------------------
// Esquema de Prisma — la "fuente de verdad" de la base de datos.
// Cada vez que cambies este archivo, corré `npm run db:migrate` y Prisma:
//   1) genera la migración SQL (la guarda en prisma/migrations/),
//   2) la aplica a Postgres,
//   3) regenera el cliente TypeScript con tipos actualizados.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"

  // El cliente se genera en packages/db/generated/client.
  // Está en .gitignore — es código generado, se regenera con `npm run db:generate`.
  output = "../generated/client"

  // 'postgresqlExtensions' habilita declarar `extensions = [vector]` abajo,
  // para que Prisma maneje `CREATE EXTENSION` en las migraciones.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Declaramos pgvector como extensión del schema. En la primera migración,
  // Prisma emitirá `CREATE EXTENSION IF NOT EXISTS vector` automáticamente.
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Modelos
// -----------------------------------------------------------------------------

/// Un documento institucional subido por el usuario (PDF, Word, contrato…).
/// Guardamos el contenido completo + sus chunks para hacer RAG.
model Document {
  id        String   @id @default(cuid())
  name      String // nombre original del archivo subido
  content   String // texto completo extraído (sin chunking)
  demoId    String // a qué demo pertenece: 'rag', 'comparator', ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // se actualiza solo en cada UPDATE
  chunks    Chunk[] // relación 1→N con sus fragmentos

  // Filtrar documentos por demo será una consulta frecuente: índice explícito.
  @@index([demoId])
}

/// Un fragmento de un Document. Cada Chunk será embebido como vector más
/// adelante para habilitar búsqueda por significado.
model Chunk {
  id         String   @id @default(cuid())
  content    String // el texto del fragmento (lo que se embedea)
  index      Int // posición del chunk en el documento (0, 1, 2, …)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // ↑ Si se borra el Document, sus Chunks se borran en cascada — sin huérfanos.

  // Embedding del chunk: vector(1536) por OpenAI text-embedding-3-small
  // (ver docs/adr/0008-openai-embeddings-for-dev.md). Nullable porque
  // durante la ingesta puede haber chunks recién creados sin embedding
  // todavía. Prisma no maneja `vector` como tipo nativo — la columna se
  // declara con Unsupported y las búsquedas de similitud se hacen con
  // $queryRaw y el operador `<=>` (distancia coseno). El índice HNSW
  // sobre esta columna se crea en la migración (Prisma no lo modela).
  embedding Unsupported("vector(1536)")?

  // (documentId, index) es único — dos chunks no comparten posición en el
  // mismo doc. El índice compuesto también sirve para listar chunks por doc.
  @@unique([documentId, index])
}
