// -----------------------------------------------------------------------------
// Esquema de Prisma — la "fuente de verdad" de la base de datos.
// Cada vez que cambies este archivo, corre `npm run db:migrate` y Prisma:
//   1) genera la migración SQL (la guarda en prisma/migrations/),
//   2) la aplica a Postgres,
//   3) regenera el cliente TypeScript con tipos actualizados.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"

  // El cliente se genera en packages/db/generated/client.
  // Está en .gitignore — es código generado, se regenera con `npm run db:generate`.
  output = "../generated/client"

  // 'postgresqlExtensions' habilita declarar `extensions = [vector]` abajo,
  // para que Prisma maneje `CREATE EXTENSION` en las migraciones.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Declaramos pgvector como extensión del schema. En la primera migración,
  // Prisma emitirá `CREATE EXTENSION IF NOT EXISTS vector` automáticamente.
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Multi-tenancy (ADR-0013) + Auth (ADR-0014)
//
// El producto evolucionó a SaaS multi-tenant. Cada cliente (Tenant) pertenece
// a una Industry y tiene Users con roles. Document/Chunk/AgentQuery suman
// tenantId en PR-MT2 — acá solo definimos las tres tablas nuevas.
//
// Las relaciones inversas (Tenant.documents, Tenant.agentQueries) NO se
// declaran todavía porque el campo `tenantId` no existe del otro lado en
// PR-MT1. Se sumarán cuando se agregue en PR-MT2.
// -----------------------------------------------------------------------------

/// Vertical de mercado. Datos relativamente estáticos: ~6 filas (universidad,
/// banca, legal, salud, gobierno, retail). Define defaults de demos
/// habilitados y configuración por industria. Los Tenant los heredan y
/// pueden sobreescribir.
model Industry {
  id            String   @id @default(cuid())
  /// Identificador legible usado en URLs y comandos CLI.
  slug          String   @unique
  displayName   String
  /// Demos habilitados por default para tenants de esta industria.
  /// Strings espejo del DemoId union del frontend (rag, comparator, corpus,
  /// agent, tutor).
  enabledDemos  String[]
  /// JSON con prompts especializados, copy del dashboard, defaults custom.
  /// Vacío `{}` por default.
  defaultConfig Json     @default("{}")
  createdAt     DateTime @default(now())
  tenants       Tenant[]
}

/// Cliente concreto. La unidad de aislamiento de datos. Cada Tenant pertenece
/// a una Industry y tiene su propio set de Users + (en PR-MT2) Documents,
/// Chunks, AgentQueries.
model Tenant {
  id                String             @id @default(cuid())
  /// Identificador legible (ej. 'utpl', 'banco-pichincha'). Usado en URLs y
  /// logs. Sin espacios, minúsculas, sin acentos.
  slug              String             @unique
  displayName       String
  industryId        String
  industry          Industry           @relation(fields: [industryId], references: [id])
  /// Sobreescribe enabledDemos de la industry si no está vacío. Si está
  /// vacío `[]`, hereda los de la industry.
  enabledDemos      String[]           @default([])
  /// Branding: `{ logoUrl, accentColor, ... }`. Vacío por default; la UI
  /// usa fallbacks del proyecto.
  branding          Json               @default("{}")
  status            TenantStatus       @default(trial)
  createdAt         DateTime           @default(now())
  users             User[]
  documents         Document[]
  agentQueries      AgentQuery[]
  // Demo 06 — Asistente clínico (ADR-0016). En el MVP los pacientes y
  // consultas viven en un tenant especial 'clinical-shared' compartido por
  // todas las clínicas que prueban el demo (decisión 1B del ADR). Los
  // protocolos clínicos sí pueden ser per-tenant si el cliente sube los
  // suyos. Las relaciones inversas viven igual en el modelo Tenant para
  // que Prisma pueda hacer joins desde Tenant.
  patients          Patient[]
  consultations     Consultation[]
  clinicalProtocols ClinicalProtocol[]
  // Demo 07 — Avatar entrevistador HR (ADR-0017). Los roles (Job) son por
  // tenant: cada empresa define sus propios puestos y rúbricas. Las
  // interviews también son del tenant del reclutador.
  jobs              Job[]
  interviews        Interview[]
  // Demo 08 — Notarización cooperativa (ADR-0019). Cada cooperativa tiene
  // su propio ledger interno (LocalAnchor) y sus anchors públicos.
  notarizedDocs     NotarizedDocument[]
  localAnchors      LocalAnchor[]
  publicAnchors     PublicAnchor[]
  notaryKey         TenantNotaryKey?
  // Demo 09 — Funnel de préstamos (ADR-0020). Cada cooperativa gestiona
  // sus propios leads en su pipeline crediticio.
  loanLeads         LoanLead[]
  // Demo 10 — BI dinámico (ADR-0021). Warehouse mock de indicadores
  // operacionales (agencias, socios, préstamos, captaciones, cuotas).
  biAgencias        BiAgencia[]
  biSocios          BiSocio[]
  biPrestamos       BiPrestamo[]
  biCaptaciones     BiCaptacion[]
  biCuotas          BiCuota[]
  biDashboardItems  BiDashboardItem[]

  @@index([industryId])
}

enum TenantStatus {
  /// Operativo. El cliente firmó contrato y paga.
  active
  /// PoC en evaluación. Por default 60 días.
  trial
  /// Pago vencido o cliente que abandona. Datos preservados; users
  /// bloqueados.
  suspended
}

/// Usuario humano que se loguea con email + contraseña (ADR-0014). Pertenece
/// a UN tenant con un rol. El `superadmin` ve todos los tenants y NO tiene
/// `tenantId` vinculante en el filtrado (es Jorge + Edguitar).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt hash (cost 12). NUNCA se expone al frontend.
  passwordHash String
  displayName  String
  role         UserRole  @default(member)
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

enum UserRole {
  /// Jorge + Edguitar. Ve todos los tenants. Crea tenants nuevos. Su
  /// tenantId apunta a un "tenant administrativo" interno (no es cliente).
  superadmin
  /// Gerente del cliente. Invita y desactiva users de SU tenant.
  admin
  /// Usuario regular del cliente. Solo consume demos del tenant.
  member
}

// -----------------------------------------------------------------------------
// Modelos
// -----------------------------------------------------------------------------

/// Un documento institucional subido por el usuario (PDF, Word, contrato…).
/// Guardamos el contenido completo + sus chunks para hacer RAG.
///
/// Los campos `year`, `authors`, `abstract` y la relación `topics` son
/// usados SOLO por el Demo 03 (Corpus académico) — son opcionales para
/// no afectar el resto de los demos (rag/comparator). El servicio de
/// corpus los popula vía extracción LLM al momento de ingest; los demás
/// servicios pueden seguir creando Documents sin tocarlos.
model Document {
  id        String   @id @default(cuid())
  name      String // nombre original del archivo subido
  content   String // texto completo extraído (sin chunking)
  demoId    String // a qué demo pertenece: 'rag', 'comparator', 'corpus', ...
  /// Tenant al que pertenece este documento (ADR-0013 multi-tenant).
  /// Cada query del backend filtra por este campo a través del TenantGuard.
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // se actualiza solo en cada UPDATE
  chunks    Chunk[] // relación 1→N con sus fragmentos

  // --- Metadata de corpus (Demo 03) — null para docs de otros demos ---
  /// Año de publicación extraído por LLM del texto del paper. Null si el
  /// LLM no encontró un año claro en el texto.
  year     Int?
  /// Autores extraídos por LLM. Array Postgres nativo. Vacío si no se
  /// encontraron autores.
  authors  String[] @default([])
  /// Resumen / abstract del paper si el LLM lo identifica claramente.
  abstract String?

  topics DocumentTopic[]

  // --- Metadata de embeddings (ADR-0018) ---
  //
  // Con qué proveedor / modelo / dimensión fue indexado este documento.
  // Sirve para dos cosas:
  //   1. Filtro de búsqueda en VectorStore.searchTopK: solo comparar contra
  //      docs del mismo espacio vectorial (vectores de OpenAI no son
  //      comparables con vectores de nomic-embed-text aunque tuvieran misma
  //      dim — viven en idiomas semánticos distintos).
  //   2. UI en /documents: mostrar al usuario con qué modelo se indexó cada
  //      doc para que pueda decidir si necesita re-subir cuando cambie el
  //      provider activo.
  //
  // Default 'private-mac' / 'nomic-embed-text' / 768: refleja el estado
  // operativo post ADR-0018. El IngestService los popula explícitamente al
  // crear cada Document; el default es una red de seguridad para inserts
  // directos (seeds, scripts) que se olviden.
  embeddingsProvider String @default("private-mac")
  embeddingsModel    String @default("nomic-embed-text")
  embeddingsDim      Int    @default(768)

  // Cada query del backend filtra por (tenantId, demoId) — índice compuesto
  // para evitar full scans. El tenantId primero porque tiene más selectividad.
  @@index([tenantId, demoId])
  // Para el gráfico papers-by-year del Demo 03, filtrado por tenant.
  @@index([tenantId, demoId, year])
  // Para filtrar por provider de embeddings en RAG — evita mezclar espacios
  // vectoriales cuando el sistema soporte múltiples providers en paralelo.
  @@index([tenantId, demoId, embeddingsProvider, embeddingsModel], map: "Document_embeddings_provider_idx")
}

/// Tópico extraído por LLM de un Document del corpus. Cada paper tiene
/// típicamente 3-5 tópicos (palabras o frases cortas en español). Sirven
/// para el "Top tópicos" del Demo 03 — agregamos COUNT por topic.
///
/// Por qué tabla aparte y no array de strings en Document:
///   - Permite COUNT y GROUP BY eficiente con índice en `topic`.
///   - Más adelante podemos sumarle metadata por tópico (confidence del LLM,
///     centroid de embedding) sin volver a migrar Document.
model DocumentTopic {
  id         String   @id @default(cuid())
  documentId String
  /// Topic en español, lowercased, una o dos palabras. Ej: "educación",
  /// "machine learning", "salud pública". El servicio normaliza al insertar.
  topic      String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Para "top tópicos" del corpus: SELECT topic, COUNT(*) GROUP BY topic.
  @@index([topic])
  // Para listar tópicos de un paper específico.
  @@index([documentId])
}

/// Un fragmento de un Document. Cada Chunk será embebido como vector más
/// adelante para habilitar búsqueda por significado.
model Chunk {
  id         String   @id @default(cuid())
  content    String // el texto del fragmento (lo que se embedea)
  index      Int // posición del chunk en el documento (0, 1, 2, …)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // ↑ Si se borra el Document, sus Chunks se borran en cascada — sin huérfanos.

  // Embedding del chunk: vector(768) por nomic-embed-text servido por NAI
  // on-prem (ver docs/adr/0018-embeddings-on-prem.md, que superó al
  // ADR-0008). Nullable porque durante la ingesta puede haber chunks recién
  // creados sin embedding todavía. Prisma no maneja `vector` como tipo
  // nativo — la columna se declara con Unsupported y las búsquedas de
  // similitud se hacen con $queryRaw y el operador `<=>` (distancia
  // coseno). El índice HNSW sobre esta columna se crea en la migración
  // (Prisma no lo modela).
  //
  // La dimensión específica del documento se guarda en
  // Document.embeddingsDim — esta declaración fija solo el shape del schema.
  // Si el sistema evoluciona para soportar varios providers de embeddings
  // en paralelo, hará falta cambiar a múltiples columnas o normalizar la
  // dim (ver discusión en ADR-0018).
  embedding Unsupported("vector(768)")?

  // (documentId, index) es único — dos chunks no comparten posición en el
  // mismo doc. El índice compuesto también sirve para listar chunks por doc.
  @@unique([documentId, index])
}

// -----------------------------------------------------------------------------
// Schema académico sintético (Demo 04 — Agente con tool use)
// -----------------------------------------------------------------------------
//
// Este sub-schema NO es producción ni viene de un cliente real: son tablas
// "de jugar" con datos seedeados deterministicamente. Sirven para que el
// agente del Demo 04 traduzca preguntas en lenguaje natural a SQL y las
// ejecute contra algo concreto.
//
// Por qué vive en el mismo Postgres que el resto:
//   - Es la DB compartida del proyecto; un solo container, un solo schema
//     Prisma. Si en el futuro el cliente trae su propia DB académica, se
//     migra a otro schema/datasource sin tocar el resto del backend.
//   - El SafeSqlExecutor del Demo 04 usa una allowlist de tablas
//     (Course, Student, Enrollment, Grade) — no puede tocar Document/Chunk
//     aunque vivan al lado.
// -----------------------------------------------------------------------------

/// Una materia / asignatura (Cálculo I, Programación II…).
model Course {
  id          String       @id @default(cuid())
  code        String       @unique // "CALC101", "PROG201", …
  name        String // "Cálculo I", "Programación II"
  credits     Int // créditos académicos (típicamente 3–6)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

/// Un estudiante del sistema académico sintético.
model Student {
  id          String       @id @default(cuid())
  fullName    String
  email       String       @unique
  enrolledAt  DateTime // fecha de matrícula al programa (no a un curso)
  enrollments Enrollment[]
}

/// Inscripción de un estudiante a un curso en un período (semestre).
/// Un estudiante puede tomar el mismo curso varias veces (en distintos
/// términos), por eso el unique compuesto incluye `term`.
model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  /// Identificador del período académico: '2024-2', '2025-1', '2025-2'.
  term      String
  status    EnrollmentStatus @default(enrolled)
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grades  Grade[]

  // Un estudiante no puede inscribirse dos veces al mismo curso en el mismo término.
  @@unique([studentId, courseId, term])
  @@index([term])
  @@index([courseId, term])
}

/// Notas individuales de un Enrollment. Cada enrollment lleva 3 grades:
/// parcial-1, parcial-2, final. Modelar las notas como tabla aparte (en
/// vez de columnas en Enrollment) habilita queries más ricas para el demo:
/// "quién aprobó el final pero reprobó la materia", "promedio del parcial-1
/// vs final", etc. — joins de 3 tablas que lucen al agente.
model Grade {
  id           String     @id @default(cuid())
  enrollmentId String
  examType     ExamType
  /// Nota 0–100. Float porque algunas instituciones usan decimales (74.5).
  score        Float
  gradedAt     DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // Una sola nota de cada tipo por inscripción.
  @@unique([enrollmentId, examType])
  @@index([examType])
}

enum EnrollmentStatus {
  enrolled // cursando o ya con notas
  withdrawn // se dio de baja
  completed // terminó (passed o failed se deriva del final)
}

enum ExamType {
  parcial_1 @map("parcial-1")
  parcial_2 @map("parcial-2")
  final
}

/// Audit log de cada pregunta procesada por el AgentService (Demo 04).
///
/// Una fila por pregunta del usuario, NO una por tool_call. Si el agente
/// llamó `run_sql` varias veces en un loop multi-vuelta, guardamos solo el
/// resultado final consolidado (sql/rowCount del último call). Cuando aparezca
/// la necesidad de auditar los pasos intermedios, agregamos una tabla hija
/// AgentQueryStep — hoy es complejidad especulativa.
///
/// `success=false` puede deberse a:
///   - Error del LLM (no respondió, max_tokens, etc.).
///   - SQL rechazada por SafeSqlExecutor (verbo / tabla fuera de allowlist).
///   - Excepción de Postgres al ejecutar.
/// El `errorMessage` distingue el caso.
///
/// Best-effort: si la conexión SSE se cae, NO garantizamos guardar la entrada
/// (no es transaccional con el response). Suficiente para auditoría tipo
/// "qué preguntó la gente"; si en algún momento es regulatorio, vamos a
/// outbox + worker.
model AgentQuery {
  id           String   @id @default(cuid())
  /// Pregunta original en lenguaje natural.
  question     String
  /// SQL final que generó el LLM. Null si el agente nunca llegó a generar
  /// una (ej: el LLM no usó tools, o falló antes).
  sql          String?
  /// Filas devueltas por la SQL final. Null si no se llegó a ejecutar.
  rowCount     Int?
  /// Duración total del agent loop end-to-end (incluye todas las vueltas).
  durationMs   Int
  /// El loop completó normalmente (stopReason=end_turn). False si falló o
  /// se truncó por MAX_TURNS.
  success      Boolean
  /// Mensaje de error humano cuando success=false. Null en success=true.
  errorMessage String?
  /// Cantidad de turns que ejecutó el loop (1 = el LLM respondió sin tools).
  turns        Int
  /// Tenant que generó esta query (ADR-0013). El AgentController inyecta el
  /// tenantId desde el JWT; la consulta de history filtra por este campo.
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  // History es siempre "del tenant actual, más recientes primero".
  @@index([tenantId, createdAt(sort: Desc)])
}

// =============================================================================
// Demo 06 — Asistente clínico (ADR-0016)
// =============================================================================
//
// El asistente clínico ayuda al médico durante la consulta resumiendo
// historia clínica, sugiriendo diagnósticos diferenciales y alertando sobre
// interacciones medicamentosas. RAG sobre consultas previas + protocolos.
//
// Por qué un tenant compartido (decisión 1B del ADR-0016):
//   En el MVP no queremos un seed por cliente que pruebe el demo. Hay un
//   tenant especial 'clinical-shared' (slug constante) que contiene 30-50
//   pacientes ficticios + sus consultas + protocolos clínicos genéricos.
//   Cualquier user de un tenant de industria 'salud' ve esos datos.
//
//   Cuando una clínica firme y quiera sus pacientes reales, el modelo está
//   listo (multi-tenant) — solo cambia el tenantId al del cliente y el
//   filtro respeta el aislamiento.
//
// Por qué Patient/Consultation NO usan pgvector (a diferencia del Demo 01):
//   El MVP arma el contexto del LLM con consultas filtradas por patientId
//   directamente (no por similitud semántica). Para v2 con miles de
//   consultas por paciente, agregamos embeddings de las notas — el patrón
//   está documentado en Demo 01.

/// Paciente ficticio. PII pseudonimizada — solo datos sintéticos para demos.
/// El demo NUNCA guarda pacientes reales sin pasar por un trámite de
/// certificación HIPAA/Ley Salud (Ecuador) que está fuera del scope MVP.
model Patient {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// ID externo en el HIS (Hospital Information System) del cliente. Solo
  /// se usa si el cliente conecta su HIS real; en el MVP es null.
  externalId         String?
  /// Nombre visible. Datos sintéticos del seed.
  displayName        String
  age                Int
  /// 'M' | 'F' | 'O'. Texto libre para no atarnos a un enum que cambia.
  gender             String
  /// Lista de alergias declaradas. Texto plano normalizado (ej. ['penicilina', 'mariscos']).
  allergies          String[]       @default([])
  /// Condiciones crónicas activas (ej. ['HTA', 'DM2', 'EPOC']).
  chronicConditions  String[]       @default([])
  /// Medicación actual con dosis. Texto libre por simplicidad
  /// (ej. ['metformina 850mg BID', 'enalapril 10mg QD']).
  currentMedications String[]       @default([])
  consultations      Consultation[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  /// (tenantId, externalId) único cuando externalId está. NULL no rompe el
  /// índice — Postgres permite múltiples NULLs en un UNIQUE.
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, displayName])
}

/// Consulta médica previa de un paciente. Construye la "historia clínica".
/// En el MVP no hay versionado ni auditoría — un PR futuro puede agregarlos
/// si el demo va a producción real.
model Consultation {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date              DateTime
  /// Nombre del médico tratante (texto libre en el MVP).
  treatingPhysician String
  reasonForVisit    String
  /// Hallazgos del examen físico. Opcional — algunas consultas son solo
  /// follow-up sin examen nuevo.
  examFindings      String?
  diagnosis         String
  treatment         String
  /// Notas adicionales libres del médico (síntomas atípicos, dudas, planes
  /// de seguimiento).
  notes             String?
  createdAt         DateTime @default(now())

  /// Filtramos por (tenantId, patientId) para traer la historia de UN
  /// paciente; el primer index lo cubre. El segundo ordena por fecha desc
  /// para la timeline de la UI.
  @@index([tenantId, patientId])
  @@index([tenantId, date(sort: Desc)])
}

/// Protocolo clínico del hospital (procedimientos estándar, guías de
/// práctica clínica, criterios de admisión). RAG sobre estos da las citas
/// que el asistente muestra en su panel de "alertas y protocolos".
/// Reusa el patrón Document/Chunk del Demo 01 — los chunks van a la tabla
/// Chunk genérica con demoId='clinical' para que pgvector haga el join.
model ClinicalProtocol {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  /// Categoría libre — el seed crea protocolos en 'cardiología', 'urgencias',
  /// 'medicina interna', 'pediatría' para que el demo tenga variedad.
  category  String
  /// Contenido en markdown. El backend hace chunking + embeddings con la
  /// maquinaria del rag-core. Los chunks van a Document/Chunk con
  /// demoId='clinical' — separado de los chunks de RAG (demoId='rag') por
  /// el filtro habitual del VectorStore.
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, category])
}

// -----------------------------------------------------------------------------
// Demo 07 — Avatar entrevistador HR (ADR-0017)
//
// Cuatro modelos:
//   - Job: rol/puesto vacante, con sus dimensiones a evaluar.
//   - JobQuestion: cada pregunta del set, en orden estable.
//   - Interview: una sesión de entrevista de un candidato para un rol.
//   - InterviewAnswer: transcripción literal de cada respuesta.
//
// Por qué `Job.dimensions` como String[] y no tabla separada: cada rol tiene
// sus propias dimensiones (técnico vs comercial vs admin) y solo se consumen
// en el prompt del scoring del LLM. Tabla separada agrega overhead sin
// amortización. Trade-off: pierdes type-safety SQL para los valores de las
// dimensiones; ganas flexibilidad para evolucionar el catálogo de dimensiones
// por rol sin migraciones.
//
// Por qué `Interview.scoring` como Json: el shape del resultado del LLM
// (dimensiones, scores, evidencias, recomendación, fortalezas, oportunidades)
// puede evolucionar con el prompt. Json absorbe la evolución sin migraciones.
// El frontend lo lee con un type guard.
// -----------------------------------------------------------------------------

model Job {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slug        String // ej. 'dev-junior-backend'
  title       String // ej. 'Desarrollador junior backend'
  description String // 1-2 párrafos describiendo el puesto
  dimensions  String[] // ej: ['claridad', 'conocimiento técnico', 'cultural fit']
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  questions   JobQuestion[]
  interviews  Interview[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model JobQuestion {
  id      String            @id @default(cuid())
  jobId   String
  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  order   Int // 0-indexed dentro del job, define la secuencia
  text    String // pregunta literal que el avatar dice por TTS
  rubric  String // qué debería contener una buena respuesta — input del LLM al scoring
  answers InterviewAnswer[]

  @@unique([jobId, order])
  @@index([jobId])
}

enum InterviewStatus {
  // Entrevista iniciada, candidato respondiendo. Las preguntas no
  // contestadas todavía no tienen su InterviewAnswer.
  in_progress
  // Entrevista terminada por el reclutador y el LLM ya emitió scoring.
  finalized
  // El reclutador cerró el browser / abandonó. No hay scoring.
  abandoned
}

model Interview {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId               String
  job                 Job               @relation(fields: [jobId], references: [id])
  candidateName       String // nombre del candidato (entrada libre del reclutador)
  candidateExternalId String? // cédula / ID externo opcional
  status              InterviewStatus   @default(in_progress)
  startedAt           DateTime          @default(now())
  finishedAt          DateTime?
  // Resultado final del LLM. Shape esperado:
  //   {
  //     dimensions: [{ name, score: 0-100, evidence: string }],
  //     overall: 0-100,
  //     recommendation: 'hire' | 'reject' | 'reconsider',
  //     strengths: string,
  //     opportunities: string
  //   }
  scoring             Json?
  answers             InterviewAnswer[]

  @@index([tenantId])
  @@index([tenantId, jobId])
  @@index([tenantId, startedAt(sort: Desc)])
}

model InterviewAnswer {
  id              String      @id @default(cuid())
  interviewId     String
  interview       Interview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  questionId      String
  question        JobQuestion @relation(fields: [questionId], references: [id])
  transcript      String // transcripción literal palabra-por-palabra
  durationSeconds Int? // opcional; el cliente lo manda
  answeredAt      DateTime    @default(now())

  // Una pregunta por entrevista — re-grabar antes de confirmar es OK porque
  // el upsert pisa el transcript, pero después de confirmar queda registro.
  @@unique([interviewId, questionId])
  @@index([interviewId])
}

// =============================================================================
// Demo 08 — Notarización cooperativa con IA (ADR-0019)
// =============================================================================
//
// Tres conceptos:
//
//   - NotarizedDocument: el PDF en sí + su contentHash + el análisis IA
//     (rellenado por el LLM en el sub-PR 4).
//   - LocalAnchor: mini-ledger interno. Una entrada por documento del tenant,
//     encadenada con prevAnchorHash al anchor anterior del MISMO tenant.
//     Firmada con la clave RSA del tenant (TenantNotaryKey).
//   - PublicAnchor: registro de una transacción on-chain (Polygon Amoy/
//     mainnet, etc). Un documento puede tener varios PublicAnchor (re-anchor
//     si falla, o anchor en distintas redes).
//
// El user del demo elige por documento si quiere SOLO LocalAnchor, SOLO
// PublicAnchor, o AMBOS. Por eso son tablas separadas, no campos en
// NotarizedDocument.
//
// Multi-tenant (ADR-0013): cada cooperativa tiene su propio ledger y su
// propia keypair. Documents de distintos tenants nunca se mezclan ni en
// la cadena de hashes ni en las firmas.

/// PDF cooperativo notarizado + analizado. Reusamos la convención del
/// resto del schema: tenantId NOT NULL, cascade al borrar el tenant.
model NotarizedDocument {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Nombre original del archivo subido por el usuario.
  name        String
  /// Tipo del documento — define qué analyzer LLM se aplica (sub-PR 4).
  docType     NotarizedDocType

  /// Texto completo extraído del PDF (mismo patrón que Document.content).
  /// Útil para el análisis posterior y para auditoría.
  content     String
  /// SHA-256 hex del BINARIO original del PDF (lo que se sella en la chain).
  /// Calculado por el backend al recibir el upload. Indexado para
  /// deduplicación y para verificación rápida.
  contentHash String
  /// Tamaño en bytes del PDF subido (para mostrar en la UI).
  contentSize Int

  /// Análisis IA del documento (poblado en sub-PR 4). JSON con dimensions
  /// extraídas + risks + recommendations. Shape estabilizado por tipo de
  /// documento (ver analyzers en el sub-PR 4). Null hasta que se completa.
  analysis    Json?

  /// Relaciones inversas a los anchors (uno-a-cero-o-uno con LocalAnchor;
  /// uno-a-muchos con PublicAnchor por si hay re-anchors).
  localAnchor   LocalAnchor?
  publicAnchors PublicAnchor[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, docType])
  @@index([tenantId, createdAt(sort: Desc)])
  /// Para verificar 'ya notarizamos este PDF?' y para deduplicación.
  @@index([contentHash])
}

/// Tipo de documento cooperativo. Define el analyzer LLM aplicado en el
/// sub-PR 4. Si llega un cuarto tipo en el futuro, sumarlo acá y agregar
/// el analyzer correspondiente — el adapter y el frontend se enteran solos.
enum NotarizedDocType {
  /// Acta de asamblea de socios.
  assembly_minutes      @map("assembly-minutes")
  /// Contrato de préstamo entre socios.
  loan
  /// Contrato de aporte de capital.
  capital_contribution  @map("capital-contribution")
}

/// Mini-ledger interno (notarizer 'Lite' de ADR-0019). Una entrada por
/// documento del tenant. Cada entrada referencia el anchor anterior del
/// mismo tenant vía prevAnchorHash, formando una cadena append-only.
/// Cualquier alteración o borrado posterior rompe la cadena, detectable
/// por verificación matemática (sub-PR 2).
model LocalAnchor {
  id              String   @id @default(cuid())
  /// 1:1 con NotarizedDocument. Si se borra el documento, se borra el
  /// anchor en cascada — pero al borrar un anchor del medio queda hueco
  /// en la cadena (los posteriores ya no verifican). Por diseño: borrar
  /// un anchor es un evento auditable.
  documentId      String   @unique
  document        NotarizedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// Tenant duplicado por performance (evita join al Document para queries
  /// del ledger por tenant).
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Posición en el ledger del tenant: 0, 1, 2, ... Unique por tenant.
  sequence        Int
  /// Hash del anchor anterior del MISMO tenant. Para el primer anchor de
  /// cada tenant es un valor GENESIS conocido (definido en el adapter).
  prevAnchorHash  String
  /// Hash del propio anchor: SHA-256( contentHash || prevAnchorHash ||
  /// sequence || createdAtTimestamp || tenantId ). Definido en sub-PR 2.
  anchorHash      String

  /// Firma del anchorHash con la clave privada del tenant. Permite a un
  /// verificador externo confirmar la autenticidad sin acceso a la BD.
  signature       String
  /// Fingerprint de la clave usada (TenantNotaryKey.fingerprint). Útil
  /// cuando rotamos claves: anchors viejos siguen verificables con la
  /// clave vieja.
  signerKeyId     String

  createdAt       DateTime @default(now())

  /// sequence es único por tenant — no global. Distintos tenants tienen
  /// sus propios ledgers paralelos.
  @@unique([tenantId, sequence])
  @@index([tenantId, createdAt(sort: Desc)])
  /// Para verificación 'dame el anchor con este anchorHash'.
  @@index([anchorHash])
}

/// Anchor en blockchain pública (Polygon Amoy/mainnet, etc).
/// Un documento puede tener varios PublicAnchor por re-intento o por
/// anchor en distintas redes.
model PublicAnchor {
  id              String   @id @default(cuid())
  documentId      String
  document        NotarizedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Identificador de la red — 'polygon-amoy' por default en el demo.
  /// Permite migrar a 'polygon-mainnet' (o agregar otras chains) sin
  /// tocar el schema.
  network         String
  /// Hash de la transacción on-chain. Null mientras está pending.
  txHash          String?
  /// Número del bloque en el que se incluyó la tx. Null hasta confirmar.
  blockNumber     BigInt?
  /// Dirección del contrato si usamos uno (en el sub-PR 3 vamos por una
  /// tx simple con data = anchoredHash, sin contrato — esto queda null).
  contractAddress String?

  /// Lo que efectivamente quedó on-chain. Para una tx simple es el mismo
  /// contentHash del documento. Si en el futuro agregamos un contrato
  /// con metadata adicional, este campo refleja el hash final que viaja.
  anchoredHash    String

  status          PublicAnchorStatus @default(pending)
  /// Cuando status=failed, mensaje humano (sin stack trace) del fallo.
  /// Sub-PR 3 limita a 500 chars y filtra info sensible (keys, URLs
  /// internas).
  errorMessage    String?

  requestedAt     DateTime @default(now())
  confirmedAt     DateTime?

  @@index([documentId])
  @@index([tenantId, status])
  /// Para resolver 'a qué documento pertenece este tx hash'.
  @@index([txHash])
}

enum PublicAnchorStatus {
  /// Tx broadcast pero esperando confirmación.
  pending
  /// Tx confirmada con suficientes bloques (típicamente 5 en Polygon).
  confirmed
  /// Tx fallida en broadcast o no incluida tras timeout.
  failed
}

/// Keypair RSA del tenant para firmar LocalAnchor. Generada al onboarding
/// (sub-PR 2). Una sola activa por tenant; al rotar guardamos las viejas
/// con activatedAt/deactivatedAt para que anchors viejos sigan
/// verificables.
///
/// Almacenamiento: privateKey va cifrada en BD con una key maestra del
/// env (NOTARY_MASTER_KEY). Para el demo bastan 32 chars random.
/// Production-grade requiere KMS — anotado como follow-up en ADR-0019.
model TenantNotaryKey {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Algoritmo: 'RSA-PSS-SHA256-2048' en el sub-PR 2. Tipo string para
  /// admitir Ed25519 más adelante.
  algorithm      String
  /// PEM de la clave pública (sin cifrar, para verificar firmas).
  publicKeyPem   String
  /// PEM de la clave privada CIFRADA con NOTARY_MASTER_KEY. Nunca expuesto
  /// al frontend ni logueado.
  privateKeyEncrypted String
  /// Fingerprint corto de la pública (primeros 16 hex chars del SHA-256
  /// del PEM). Usado como signerKeyId en LocalAnchor.
  fingerprint    String

  activatedAt    DateTime @default(now())
  /// Null mientras la key está activa. Se llena al rotar.
  deactivatedAt  DateTime?

  @@index([fingerprint])
}

// ============================================================================
// Demo 09 — Funnel de préstamos asistido por IA (ADR-0020)
// ============================================================================
//
// El demo modela un "pipeline de préstamos" para cooperativas de ahorro y
// crédito (CACs). Cada socio que solicita un préstamo es un LoanLead que
// avanza por etapas (lead → qualification → ... → disbursement → servicing),
// movido por un asistente IA conversacional que llama tools del backend.
//
// 3 modelos:
//   - LoanLead: la "tarjeta" del kanban. Estado actual + datos del socio +
//     id en el core bancario externo.
//   - LoanConversation: historial chat completo (role + content + toolCall).
//     Audit trail de qué dijo el LLM y qué tool llamó.
//   - LoanStageHistory: audit trail de transiciones de etapa (quién movió,
//     desde dónde, hacia dónde, por qué).
//
// La integración con el core bancario es vía MockCoreBankingAdapter en el
// package @org/core-banking-adapter (sub-PR 1). El core real (Cobis,
// Conexus, Compac) se enchufa cambiando el provider — la lógica no se toca.

/// Etapas canónicas del funnel de préstamos para CACs ecuatorianas.
/// Basado en el flujo estándar regulado por SEPS / LOEPS.
enum LoanStage {
  /// Socio contactó. Datos mínimos (nombre, teléfono).
  lead
  /// Pre-calificación: monto solicitado, plazo, propósito del préstamo.
  qualification
  /// Recolección de documentos: cédula, rol de pagos, planilla básica.
  documentation
  /// Evaluación crediticia: consulta al core bancario + score interno +
  /// cálculo de ratio cuota/ingreso.
  credit_evaluation
  /// Decisión final: aprobado, contra-oferta o pendiente de comité.
  approval
  /// Firma de pagaré + desembolso a la cuenta del socio.
  disbursement
  /// Préstamo activo, cobro de cuotas mensuales.
  servicing
  /// Terminal alternativo: solicitud rechazada. Real-world las CACs
  /// permiten re-aplicar después de un cooldown, modelado en el demo
  /// con un campo opcional rejectedUntil (sub-PR 5).
  rejected
}

/// "Tarjeta" del kanban — un socio que está solicitando o tiene un
/// préstamo activo en la cooperativa. Vive en una etapa del funnel
/// (currentStage) y avanza vía la tool moveToStage() del LLM.
///
/// Multi-tenant: cada tenant ve solo sus propios leads (filtrado en
/// el service con tenantId del JWT).
model LoanLead {
  id              String     @id @default(cuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ----- Datos del socio -----
  fullName        String
  phone           String
  /// Cédula ecuatoriana — 10 dígitos. Opcional hasta etapa qualification.
  idNumber        String?
  /// Propósito del préstamo en lenguaje libre del socio. Útil para
  /// análisis de cartera y reporting regulatorio.
  purpose         String?

  // ----- Solicitud -----
  /// Monto solicitado en USD (la moneda de Ecuador). Decimal para
  /// evitar imprecisión de floats.
  requestedAmount Decimal?   @db.Decimal(12, 2)
  /// Plazo en meses. Típico CAC: 6, 12, 24, 36, 48.
  termMonths      Int?

  // ----- Estado en el funnel -----
  currentStage    LoanStage  @default(lead)

  // ----- Integración con core bancario (mock o real) -----
  /// requestId que devolvió el CoreBankingAdapter al crear la solicitud.
  /// Permite consultas posteriores al core sin re-enviar datos.
  coreRequestId   String?
  /// Snapshot del último análisis crediticio (score, ratios, veredicto).
  /// JSON porque la forma del análisis evoluciona y no queremos churn
  /// de migraciones por cada cambio de forma.
  lastEligibility Json?

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  conversations   LoanConversation[]
  stageHistory    LoanStageHistory[]

  @@index([tenantId, currentStage])
  @@index([tenantId, phone])
}

/// Historial completo del chat entre el socio y el asistente IA. Un
/// turn por fila. Audit trail + permite rehidratar el contexto para
/// nuevas respuestas del LLM.
model LoanConversation {
  id        String   @id @default(cuid())
  leadId    String
  lead      LoanLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// 'user' (mensaje del socio) o 'assistant' (respuesta del bot).
  /// String suelto en vez de enum para tolerar 'tool' o 'system' si
  /// el flujo lo necesita más adelante.
  role      String
  /// Texto plano del mensaje. Si el assistant usó una tool, content
  /// suele ser vacío y toolCall contiene los detalles.
  content   String   @db.Text

  /// Si este turn corresponde a una llamada a tool del LLM, acá vive
  /// el detalle: { name, input, output }. Null para mensajes de texto
  /// normales. JSON porque cada tool tiene su propio shape.
  toolCall  Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

/// Audit trail de transiciones de etapa. Cada vez que un lead cambia
/// de etapa, se inserta una fila. Permite reportar tasas de
/// conversión, tiempos por etapa, y quién/qué movió cada lead.
model LoanStageHistory {
  id        String     @id @default(cuid())
  leadId    String
  lead      LoanLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Etapa de la que venía. Null para el primer registro (creación).
  fromStage LoanStage?
  toStage   LoanStage

  /// Quién/qué movió la etapa:
  ///   - 'llm': el bot llamó moveToStage() durante el chat.
  ///   - 'officer': el oficial de crédito tocó algo en el kanban.
  ///   - 'system': transición automática (ej. auto-rechazo por timeout).
  movedBy   String
  /// Texto libre con la razón. Útil para auditoría SEPS.
  reason    String?

  createdAt DateTime   @default(now())

  @@index([leadId, createdAt])
}

// ============================================================================
// Demo 10 — BI dinámico / dashboard inteligente (ADR-0021)
// ============================================================================
//
// Warehouse mock para que el LLM ejecute SQL contra él. 5 tablas que modelan
// los indicadores típicos de una CAC ecuatoriana:
//   - BiAgencia    : sucursales físicas de la cooperativa.
//   - BiSocio      : afiliados (clientes finales).
//   - BiPrestamo   : préstamos vigentes/cancelados/vencidos.
//   - BiCaptacion  : depósitos a la vista y plazos fijos.
//   - BiCuota      : cuotas de los préstamos (para queries de cartera vencida).
//
// La whitelist del `sql-safety.ts` (sub-PR 2) limita al LLM a SELECT sobre
// estas 5 tablas. El `tenantId` se inyecta forzado en cada WHERE para que
// un tenant no vea data de otro (lo mismo que el resto del sistema).

/// Sucursal física de la cooperativa. Una CAC mediana tiene 5-15 agencias.
model BiAgencia {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Código corto interno tipo "AG-001". Útil para joins legibles en SQL.
  codigo        String
  nombre        String
  ciudad        String
  provincia     String
  fechaApertura DateTime

  socios        BiSocio[]

  @@unique([tenantId, codigo])
  @@index([tenantId, provincia])
}

/// Socio (cliente) de la cooperativa. Cada socio pertenece a la agencia
/// donde se afilió originalmente. Para queries de demografía (edad por
/// agencia, ingreso promedio por provincia, etc).
model BiSocio {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agenciaId         String
  agencia           BiAgencia @relation(fields: [agenciaId], references: [id], onDelete: Cascade)

  fechaIngreso      DateTime
  edad              Int
  /// 'M' (masculino), 'F' (femenino), 'X' (no especificado). Sin enum
  /// para tolerar nuevos valores sin migración futura.
  sexo              String
  /// Categoría libre: 'empleado', 'comerciante', 'profesional', 'agricultor', etc.
  ocupacion         String
  ingresoMensualUsd Decimal  @db.Decimal(10, 2)

  prestamos         BiPrestamo[]
  captaciones       BiCaptacion[]

  @@index([tenantId, agenciaId])
  @@index([tenantId, ocupacion])
}

/// Préstamo otorgado a un socio. Una sola tabla con `estado` que cambia
/// en el tiempo — para queries históricas usar `fechaDesembolso`.
///
/// `diasMora` se calcula al cierre del mes y se persiste para que las
/// queries del LLM no tengan que computarlo desde BiCuota.
model BiPrestamo {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  socioId         String
  socio           BiSocio  @relation(fields: [socioId], references: [id], onDelete: Cascade)
  /// Denormalizado para queries rápidas tipo "morosidad por agencia".
  agenciaId       String

  /// Categoría del producto: 'consumo', 'vivienda', 'microempresa', 'auto', etc.
  productoTipo    String
  montoUsd        Decimal  @db.Decimal(12, 2)
  plazoMeses      Int
  tasaAnual       Decimal  @db.Decimal(5, 2)
  fechaDesembolso DateTime
  fechaCancelacion DateTime?
  /// 'vigente' | 'cancelado' | 'vencido' | 'castigado'.
  estado          String
  /// Días de mora al último cierre mensual. 0 si está al día o cancelado.
  diasMora        Int      @default(0)

  cuotas          BiCuota[]

  @@index([tenantId, agenciaId, estado])
  @@index([tenantId, productoTipo])
  @@index([tenantId, fechaDesembolso])
}

/// Captación: depósito del socio (ahorro a la vista, plazo fijo,
/// ahorro programado). Para queries de fondeo / liquidez.
model BiCaptacion {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  socioId       String
  socio         BiSocio  @relation(fields: [socioId], references: [id], onDelete: Cascade)
  /// Denormalizado.
  agenciaId     String

  /// 'ahorro_vista' | 'plazo_fijo' | 'ahorro_navideno' | 'ahorro_escolar'.
  productoTipo  String
  saldoUsd      Decimal  @db.Decimal(12, 2)
  fechaApertura DateTime
  fechaCierre   DateTime?
  /// 'activa' | 'cerrada'.
  estado        String

  @@index([tenantId, agenciaId, estado])
  @@index([tenantId, productoTipo])
}

/// Cuota mensual de un préstamo. ~5-10 cuotas en promedio por préstamo
/// vigente. Permite queries detalladas de cartera vencida y proyecciones
/// de cobranza.
model BiCuota {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prestamoId      String
  prestamo        BiPrestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)

  /// Número de cuota dentro del cronograma (1..plazoMeses).
  numero          Int
  fechaProgramada DateTime
  fechaPago       DateTime?
  montoUsd        Decimal  @db.Decimal(10, 2)
  /// 'pagada' | 'pendiente' | 'vencida'.
  estado          String
  diasAtraso      Int      @default(0)

  @@index([tenantId, prestamoId])
  @@index([tenantId, estado])
}

/// Demo 10 — Item del dashboard guardado (ADR-0021, sub-PR 4).
///
/// Cuando un usuario genera un chart con run_sql + render_chart y le gusta,
/// puede "Guardar al dashboard". Eso persiste el SQL ya sanitizado + la
/// spec del chart + el título + la pregunta original. Cuando alguien del
/// mismo tenant entra a /demo/bi/dashboard, los items se re-ejecutan
/// contra el warehouse para mostrar datos actuales.
///
/// El dashboard es per-tenant (no per-user): el oficial guarda un chart y
/// el gerente lo ve también. Para el demo es lo más útil.
model BiDashboardItem {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Título corto editable por el usuario al guardar (default = chart.title).
  title          String
  /// Pregunta original en español. Útil para mostrar al usuario "lo que pediste fue X".
  question       String
  /// SQL ejecutado (post-safety). Se re-ejecuta tal cual al refrescar.
  sql            String   @db.Text
  /// Snapshot de las tablas que tocaba el SQL — útil para badges.
  tablesUsed     String[]
  /// Spec del gráfico tal como la emitió render_chart. JSON.
  chartSpec      Json
  /// Orden manual dentro de la grid del dashboard. Menor número primero.
  order          Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, order])
}
