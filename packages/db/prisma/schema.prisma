// -----------------------------------------------------------------------------
// Esquema de Prisma — la "fuente de verdad" de la base de datos.
// Cada vez que cambies este archivo, corre `npm run db:migrate` y Prisma:
//   1) genera la migración SQL (la guarda en prisma/migrations/),
//   2) la aplica a Postgres,
//   3) regenera el cliente TypeScript con tipos actualizados.
// -----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"

  // El cliente se genera en packages/db/generated/client.
  // Está en .gitignore — es código generado, se regenera con `npm run db:generate`.
  output = "../generated/client"

  // 'postgresqlExtensions' habilita declarar `extensions = [vector]` abajo,
  // para que Prisma maneje `CREATE EXTENSION` en las migraciones.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Declaramos pgvector como extensión del schema. En la primera migración,
  // Prisma emitirá `CREATE EXTENSION IF NOT EXISTS vector` automáticamente.
  extensions = [vector]
}

// -----------------------------------------------------------------------------
// Multi-tenancy (ADR-0013) + Auth (ADR-0014)
//
// El producto evolucionó a SaaS multi-tenant. Cada cliente (Tenant) pertenece
// a una Industry y tiene Users con roles. Document/Chunk/AgentQuery suman
// tenantId en PR-MT2 — acá solo definimos las tres tablas nuevas.
//
// Las relaciones inversas (Tenant.documents, Tenant.agentQueries) NO se
// declaran todavía porque el campo `tenantId` no existe del otro lado en
// PR-MT1. Se sumarán cuando se agregue en PR-MT2.
// -----------------------------------------------------------------------------

/// Vertical de mercado. Datos relativamente estáticos: ~6 filas (universidad,
/// banca, legal, salud, gobierno, retail). Define defaults de demos
/// habilitados y configuración por industria. Los Tenant los heredan y
/// pueden sobreescribir.
model Industry {
  id            String   @id @default(cuid())
  /// Identificador legible usado en URLs y comandos CLI.
  slug          String   @unique
  displayName   String
  /// Demos habilitados por default para tenants de esta industria.
  /// Strings espejo del DemoId union del frontend (rag, comparator, corpus,
  /// agent, tutor).
  enabledDemos  String[]
  /// JSON con prompts especializados, copy del dashboard, defaults custom.
  /// Vacío `{}` por default.
  defaultConfig Json     @default("{}")
  createdAt     DateTime @default(now())
  tenants       Tenant[]
}

/// Cliente concreto. La unidad de aislamiento de datos. Cada Tenant pertenece
/// a una Industry y tiene su propio set de Users + (en PR-MT2) Documents,
/// Chunks, AgentQueries.
model Tenant {
  id           String       @id @default(cuid())
  /// Identificador legible (ej. 'utpl', 'banco-pichincha'). Usado en URLs y
  /// logs. Sin espacios, minúsculas, sin acentos.
  slug         String       @unique
  displayName  String
  industryId   String
  industry     Industry     @relation(fields: [industryId], references: [id])
  /// Sobreescribe enabledDemos de la industry si no está vacío. Si está
  /// vacío `[]`, hereda los de la industry.
  enabledDemos String[]     @default([])
  /// Branding: `{ logoUrl, accentColor, ... }`. Vacío por default; la UI
  /// usa fallbacks del proyecto.
  branding     Json         @default("{}")
  status       TenantStatus @default(trial)
  createdAt    DateTime     @default(now())
  users        User[]
  documents    Document[]
  agentQueries AgentQuery[]
  // Demo 06 — Asistente clínico (ADR-0016). En el MVP los pacientes y
  // consultas viven en un tenant especial 'clinical-shared' compartido por
  // todas las clínicas que prueban el demo (decisión 1B del ADR). Los
  // protocolos clínicos sí pueden ser per-tenant si el cliente sube los
  // suyos. Las relaciones inversas viven igual en el modelo Tenant para
  // que Prisma pueda hacer joins desde Tenant.
  patients          Patient[]
  consultations     Consultation[]
  clinicalProtocols ClinicalProtocol[]

  @@index([industryId])
}

enum TenantStatus {
  /// Operativo. El cliente firmó contrato y paga.
  active
  /// PoC en evaluación. Por default 60 días.
  trial
  /// Pago vencido o cliente que abandona. Datos preservados; users
  /// bloqueados.
  suspended
}

/// Usuario humano que se loguea con email + contraseña (ADR-0014). Pertenece
/// a UN tenant con un rol. El `superadmin` ve todos los tenants y NO tiene
/// `tenantId` vinculante en el filtrado (es Jorge + Edguitar).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt hash (cost 12). NUNCA se expone al frontend.
  passwordHash String
  displayName  String
  role         UserRole  @default(member)
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId])
}

enum UserRole {
  /// Jorge + Edguitar. Ve todos los tenants. Crea tenants nuevos. Su
  /// tenantId apunta a un "tenant administrativo" interno (no es cliente).
  superadmin
  /// Gerente del cliente. Invita y desactiva users de SU tenant.
  admin
  /// Usuario regular del cliente. Solo consume demos del tenant.
  member
}

// -----------------------------------------------------------------------------
// Modelos
// -----------------------------------------------------------------------------

/// Un documento institucional subido por el usuario (PDF, Word, contrato…).
/// Guardamos el contenido completo + sus chunks para hacer RAG.
///
/// Los campos `year`, `authors`, `abstract` y la relación `topics` son
/// usados SOLO por el Demo 03 (Corpus académico) — son opcionales para
/// no afectar el resto de los demos (rag/comparator). El servicio de
/// corpus los popula vía extracción LLM al momento de ingest; los demás
/// servicios pueden seguir creando Documents sin tocarlos.
model Document {
  id        String   @id @default(cuid())
  name      String // nombre original del archivo subido
  content   String // texto completo extraído (sin chunking)
  demoId    String // a qué demo pertenece: 'rag', 'comparator', 'corpus', ...
  /// Tenant al que pertenece este documento (ADR-0013 multi-tenant).
  /// Cada query del backend filtra por este campo a través del TenantGuard.
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // se actualiza solo en cada UPDATE
  chunks    Chunk[] // relación 1→N con sus fragmentos

  // --- Metadata de corpus (Demo 03) — null para docs de otros demos ---
  /// Año de publicación extraído por LLM del texto del paper. Null si el
  /// LLM no encontró un año claro en el texto.
  year      Int?
  /// Autores extraídos por LLM. Array Postgres nativo. Vacío si no se
  /// encontraron autores.
  authors   String[] @default([])
  /// Resumen / abstract del paper si el LLM lo identifica claramente.
  abstract  String?

  topics DocumentTopic[]

  // Cada query del backend filtra por (tenantId, demoId) — índice compuesto
  // para evitar full scans. El tenantId primero porque tiene más selectividad.
  @@index([tenantId, demoId])
  // Para el gráfico papers-by-year del Demo 03, filtrado por tenant.
  @@index([tenantId, demoId, year])
}

/// Tópico extraído por LLM de un Document del corpus. Cada paper tiene
/// típicamente 3-5 tópicos (palabras o frases cortas en español). Sirven
/// para el "Top tópicos" del Demo 03 — agregamos COUNT por topic.
///
/// Por qué tabla aparte y no array de strings en Document:
///   - Permite COUNT y GROUP BY eficiente con índice en `topic`.
///   - Más adelante podemos sumarle metadata por tópico (confidence del LLM,
///     centroid de embedding) sin volver a migrar Document.
model DocumentTopic {
  id         String   @id @default(cuid())
  documentId String
  /// Topic en español, lowercased, una o dos palabras. Ej: "educación",
  /// "machine learning", "salud pública". El servicio normaliza al insertar.
  topic      String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Para "top tópicos" del corpus: SELECT topic, COUNT(*) GROUP BY topic.
  @@index([topic])
  // Para listar tópicos de un paper específico.
  @@index([documentId])
}

/// Un fragmento de un Document. Cada Chunk será embebido como vector más
/// adelante para habilitar búsqueda por significado.
model Chunk {
  id         String   @id @default(cuid())
  content    String // el texto del fragmento (lo que se embedea)
  index      Int // posición del chunk en el documento (0, 1, 2, …)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // ↑ Si se borra el Document, sus Chunks se borran en cascada — sin huérfanos.

  // Embedding del chunk: vector(1536) por OpenAI text-embedding-3-small
  // (ver docs/adr/0008-openai-embeddings-for-dev.md). Nullable porque
  // durante la ingesta puede haber chunks recién creados sin embedding
  // todavía. Prisma no maneja `vector` como tipo nativo — la columna se
  // declara con Unsupported y las búsquedas de similitud se hacen con
  // $queryRaw y el operador `<=>` (distancia coseno). El índice HNSW
  // sobre esta columna se crea en la migración (Prisma no lo modela).
  embedding Unsupported("vector(1536)")?

  // (documentId, index) es único — dos chunks no comparten posición en el
  // mismo doc. El índice compuesto también sirve para listar chunks por doc.
  @@unique([documentId, index])
}

// -----------------------------------------------------------------------------
// Schema académico sintético (Demo 04 — Agente con tool use)
// -----------------------------------------------------------------------------
//
// Este sub-schema NO es producción ni viene de un cliente real: son tablas
// "de jugar" con datos seedeados deterministicamente. Sirven para que el
// agente del Demo 04 traduzca preguntas en lenguaje natural a SQL y las
// ejecute contra algo concreto.
//
// Por qué vive en el mismo Postgres que el resto:
//   - Es la DB compartida del proyecto; un solo container, un solo schema
//     Prisma. Si en el futuro el cliente trae su propia DB académica, se
//     migra a otro schema/datasource sin tocar el resto del backend.
//   - El SafeSqlExecutor del Demo 04 usa una allowlist de tablas
//     (Course, Student, Enrollment, Grade) — no puede tocar Document/Chunk
//     aunque vivan al lado.
// -----------------------------------------------------------------------------

/// Una materia / asignatura (Cálculo I, Programación II…).
model Course {
  id          String       @id @default(cuid())
  code        String       @unique // "CALC101", "PROG201", …
  name        String // "Cálculo I", "Programación II"
  credits     Int // créditos académicos (típicamente 3–6)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

/// Un estudiante del sistema académico sintético.
model Student {
  id          String       @id @default(cuid())
  fullName    String
  email       String       @unique
  enrolledAt  DateTime // fecha de matrícula al programa (no a un curso)
  enrollments Enrollment[]
}

/// Inscripción de un estudiante a un curso en un período (semestre).
/// Un estudiante puede tomar el mismo curso varias veces (en distintos
/// términos), por eso el unique compuesto incluye `term`.
model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  courseId  String
  /// Identificador del período académico: '2024-2', '2025-1', '2025-2'.
  term      String
  status    EnrollmentStatus @default(enrolled)
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grades  Grade[]

  // Un estudiante no puede inscribirse dos veces al mismo curso en el mismo término.
  @@unique([studentId, courseId, term])
  @@index([term])
  @@index([courseId, term])
}

/// Notas individuales de un Enrollment. Cada enrollment lleva 3 grades:
/// parcial-1, parcial-2, final. Modelar las notas como tabla aparte (en
/// vez de columnas en Enrollment) habilita queries más ricas para el demo:
/// "quién aprobó el final pero reprobó la materia", "promedio del parcial-1
/// vs final", etc. — joins de 3 tablas que lucen al agente.
model Grade {
  id           String     @id @default(cuid())
  enrollmentId String
  examType     ExamType
  /// Nota 0–100. Float porque algunas instituciones usan decimales (74.5).
  score        Float
  gradedAt     DateTime   @default(now())
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // Una sola nota de cada tipo por inscripción.
  @@unique([enrollmentId, examType])
  @@index([examType])
}

enum EnrollmentStatus {
  enrolled // cursando o ya con notas
  withdrawn // se dio de baja
  completed // terminó (passed o failed se deriva del final)
}

enum ExamType {
  parcial_1 @map("parcial-1")
  parcial_2 @map("parcial-2")
  final
}

/// Audit log de cada pregunta procesada por el AgentService (Demo 04).
///
/// Una fila por pregunta del usuario, NO una por tool_call. Si el agente
/// llamó `run_sql` varias veces en un loop multi-vuelta, guardamos solo el
/// resultado final consolidado (sql/rowCount del último call). Cuando aparezca
/// la necesidad de auditar los pasos intermedios, agregamos una tabla hija
/// AgentQueryStep — hoy es complejidad especulativa.
///
/// `success=false` puede deberse a:
///   - Error del LLM (no respondió, max_tokens, etc.).
///   - SQL rechazada por SafeSqlExecutor (verbo / tabla fuera de allowlist).
///   - Excepción de Postgres al ejecutar.
/// El `errorMessage` distingue el caso.
///
/// Best-effort: si la conexión SSE se cae, NO garantizamos guardar la entrada
/// (no es transaccional con el response). Suficiente para auditoría tipo
/// "qué preguntó la gente"; si en algún momento es regulatorio, vamos a
/// outbox + worker.
model AgentQuery {
  id            String   @id @default(cuid())
  /// Pregunta original en lenguaje natural.
  question      String
  /// SQL final que generó el LLM. Null si el agente nunca llegó a generar
  /// una (ej: el LLM no usó tools, o falló antes).
  sql           String?
  /// Filas devueltas por la SQL final. Null si no se llegó a ejecutar.
  rowCount      Int?
  /// Duración total del agent loop end-to-end (incluye todas las vueltas).
  durationMs    Int
  /// El loop completó normalmente (stopReason=end_turn). False si falló o
  /// se truncó por MAX_TURNS.
  success       Boolean
  /// Mensaje de error humano cuando success=false. Null en success=true.
  errorMessage  String?
  /// Cantidad de turns que ejecutó el loop (1 = el LLM respondió sin tools).
  turns         Int
  /// Tenant que generó esta query (ADR-0013). El AgentController inyecta el
  /// tenantId desde el JWT; la consulta de history filtra por este campo.
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  // History es siempre "del tenant actual, más recientes primero".
  @@index([tenantId, createdAt(sort: Desc)])
}

// =============================================================================
// Demo 06 — Asistente clínico (ADR-0016)
// =============================================================================
//
// El asistente clínico ayuda al médico durante la consulta resumiendo
// historia clínica, sugiriendo diagnósticos diferenciales y alertando sobre
// interacciones medicamentosas. RAG sobre consultas previas + protocolos.
//
// Por qué un tenant compartido (decisión 1B del ADR-0016):
//   En el MVP no queremos un seed por cliente que pruebe el demo. Hay un
//   tenant especial 'clinical-shared' (slug constante) que contiene 30-50
//   pacientes ficticios + sus consultas + protocolos clínicos genéricos.
//   Cualquier user de un tenant de industria 'salud' ve esos datos.
//
//   Cuando una clínica firme y quiera sus pacientes reales, el modelo está
//   listo (multi-tenant) — solo cambia el tenantId al del cliente y el
//   filtro respeta el aislamiento.
//
// Por qué Patient/Consultation NO usan pgvector (a diferencia del Demo 01):
//   El MVP arma el contexto del LLM con consultas filtradas por patientId
//   directamente (no por similitud semántica). Para v2 con miles de
//   consultas por paciente, agregamos embeddings de las notas — el patrón
//   está documentado en Demo 01.

/// Paciente ficticio. PII pseudonimizada — solo datos sintéticos para demos.
/// El demo NUNCA guarda pacientes reales sin pasar por un trámite de
/// certificación HIPAA/Ley Salud (Ecuador) que está fuera del scope MVP.
model Patient {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// ID externo en el HIS (Hospital Information System) del cliente. Solo
  /// se usa si el cliente conecta su HIS real; en el MVP es null.
  externalId         String?
  /// Nombre visible. Datos sintéticos del seed.
  displayName        String
  age                Int
  /// 'M' | 'F' | 'O'. Texto libre para no atarnos a un enum que cambia.
  gender             String
  /// Lista de alergias declaradas. Texto plano normalizado (ej. ['penicilina', 'mariscos']).
  allergies          String[] @default([])
  /// Condiciones crónicas activas (ej. ['HTA', 'DM2', 'EPOC']).
  chronicConditions  String[] @default([])
  /// Medicación actual con dosis. Texto libre por simplicidad
  /// (ej. ['metformina 850mg BID', 'enalapril 10mg QD']).
  currentMedications String[] @default([])
  consultations      Consultation[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// (tenantId, externalId) único cuando externalId está. NULL no rompe el
  /// índice — Postgres permite múltiples NULLs en un UNIQUE.
  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, displayName])
}

/// Consulta médica previa de un paciente. Construye la "historia clínica".
/// En el MVP no hay versionado ni auditoría — un PR futuro puede agregarlos
/// si el demo va a producción real.
model Consultation {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date              DateTime
  /// Nombre del médico tratante (texto libre en el MVP).
  treatingPhysician String
  reasonForVisit    String
  /// Hallazgos del examen físico. Opcional — algunas consultas son solo
  /// follow-up sin examen nuevo.
  examFindings      String?
  diagnosis         String
  treatment         String
  /// Notas adicionales libres del médico (síntomas atípicos, dudas, planes
  /// de seguimiento).
  notes             String?
  createdAt         DateTime @default(now())

  /// Filtramos por (tenantId, patientId) para traer la historia de UN
  /// paciente; el primer index lo cubre. El segundo ordena por fecha desc
  /// para la timeline de la UI.
  @@index([tenantId, patientId])
  @@index([tenantId, date(sort: Desc)])
}

/// Protocolo clínico del hospital (procedimientos estándar, guías de
/// práctica clínica, criterios de admisión). RAG sobre estos da las citas
/// que el asistente muestra en su panel de "alertas y protocolos".
/// Reusa el patrón Document/Chunk del Demo 01 — los chunks van a la tabla
/// Chunk genérica con demoId='clinical' para que pgvector haga el join.
model ClinicalProtocol {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  /// Categoría libre — el seed crea protocolos en 'cardiología', 'urgencias',
  /// 'medicina interna', 'pediatría' para que el demo tenga variedad.
  category  String
  /// Contenido en markdown. El backend hace chunking + embeddings con la
  /// maquinaria del rag-core. Los chunks van a Document/Chunk con
  /// demoId='clinical' — separado de los chunks de RAG (demoId='rag') por
  /// el filtro habitual del VectorStore.
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, category])
}
