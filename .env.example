# -----------------------------------------------------------------------------
# PLANTILLA de variables de entorno — este archivo SÍ se commitea.
# Sirve para que cualquiera que clone el repo sepa qué variables existen.
# Para usarlo en local:  cp .env.example .env
#
# En producción, estos valores se reemplazan por secretos reales inyectados
# desde la plataforma (Vercel env vars, GitHub Actions secrets, etc.).
# -----------------------------------------------------------------------------

# --- Base de datos Postgres (la levanta docker-compose.yml) ---
POSTGRES_USER=aidemo
POSTGRES_PASSWORD=aidemo
POSTGRES_DB=aidemo

# URL de conexión que usa Prisma para hablar con Postgres.
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base>?schema=<schema>
DATABASE_URL=postgresql://aidemo:aidemo@localhost:5434/aidemo?schema=public

# --- LLM: chat (dev: Anthropic, prod: NAI vía openai-compat) ---
# Ver docs/adr/0004-llm-adapter-pattern.md y docs/adr/0009-split-llm-adapter.md
CHAT_PROVIDER=anthropic
CHAT_API_KEY=
CHAT_MODEL=claude-sonnet-4-20250514
# Solo necesaria cuando CHAT_PROVIDER=openai-compat (ej: NAI en prod)
CHAT_BASE_URL=

# --- LLM: embeddings (dev: OpenAI, prod: NAI vía openai-compat) ---
# Ver docs/adr/0008-openai-embeddings-for-dev.md y docs/adr/0009-split-llm-adapter.md
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
# Solo necesaria cuando EMBEDDINGS_PROVIDER=openai-compat (ej: NAI en prod)
EMBEDDINGS_BASE_URL=

