# -----------------------------------------------------------------------------
# PLANTILLA de variables de entorno — este archivo SÍ se commitea.
# Sirve para que cualquiera que clone el repo sepa qué variables existen.
# Para usarlo en local:  cp .env.example .env
#
# En producción, estos valores se reemplazan por secretos reales inyectados
# desde la plataforma (Vercel env vars, GitHub Actions secrets, etc.).
# -----------------------------------------------------------------------------

# --- Base de datos Postgres (la levanta docker-compose.yml) ---
POSTGRES_USER=aidemo
POSTGRES_PASSWORD=aidemo
POSTGRES_DB=aidemo

# URL de conexión que usa Prisma para hablar con Postgres.
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base>?schema=<schema>
DATABASE_URL=postgresql://aidemo:aidemo@localhost:5434/aidemo?schema=public

# --- LLM: chat (dev: Anthropic, prod: NAI vía openai-compat) ---
# Ver docs/adr/0004-llm-adapter-pattern.md y docs/adr/0009-split-llm-adapter.md
#
# IMPORTANTE: el server VALIDA estas variables al boot. Si CHAT_API_KEY queda
# vacía, NestFactory.create() lanza con un mensaje claro y el server no
# arranca. Es a propósito: preferimos fallar al boot que dar 500s confusos
# cuando alguien intenta usar el chat. Para dev sin keys reales, poné un
# placeholder no-vacío (ej: 'sk-ant-placeholder') — el server arranca, los
# endpoints que NO usen el LLM (health, demos, documents/list) funcionan; los
# que sí lo usen (ingest, chat, compare, agent) fallarán al llamar al provider.
#
# Provider 'fake': implementación determinística sin llamadas reales al LLM.
# Pensado para CI y tests E2E (ver providers/fake-chat.ts y fake-embeddings.ts).
# Con fake NO se exigen API keys ni baseUrl. NO usar en producción — solo
# responde lo que tiene hardcoded para las preguntas sugeridas de los demos.
CHAT_PROVIDER=anthropic
CHAT_API_KEY=sk-ant-placeholder
CHAT_MODEL=claude-sonnet-4-20250514
# Solo necesaria cuando CHAT_PROVIDER=openai-compat (ej: NAI en prod)
CHAT_BASE_URL=

# --- LLM: embeddings (dev: OpenAI, prod: NAI vía openai-compat, tests: fake) ---
# Ver docs/adr/0008-openai-embeddings-for-dev.md y docs/adr/0009-split-llm-adapter.md
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_API_KEY=sk-openai-placeholder
EMBEDDINGS_MODEL=text-embedding-3-small
# Solo necesaria cuando EMBEDDINGS_PROVIDER=openai-compat (ej: NAI en prod)
EMBEDDINGS_BASE_URL=

# =============================================================================
# Deploy a producción (Railway backend + Vercel frontend)
# =============================================================================
# Estas variables NO se usan en dev local (quedan vacías en .env). Se setean
# como secrets en Railway (backend) y Vercel (frontend). Documentadas acá
# para que el lector entienda la cadena completa.

# --- Backend (Railway) ---
# Shared secret entre el proxy de Next.js y el InternalKeyGuard del backend.
# Si está vacío: guard inactivo, el backend acepta cualquier request (OK en
# dev local). En prod debe estar seteado en AMBOS sides con el MISMO valor.
INTERNAL_API_KEY=

# --- Frontend (Vercel) ---
# URL del backend al que el proxy server-side de Next.js (apps/web/src/app/api/
# [...path]/route.ts) reenvía las requests. En dev: localhost:3000.
BACKEND_URL=http://localhost:3000

# Basic auth para proteger el deploy público. Si AMBAS están seteadas, el
# middleware de Next pide credenciales antes de servir cualquier ruta. En
# dev local, dejar vacías → no se aplica.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

